# 0. DATA LOADING & PREPROCESSING
# ==========================================
Print(“--- Loading and Cleaning Data ---“)
Df = pd.read_csv(‘MLAMR.csv’)

# Strip trailing/leading spaces from column names
Df.columns = df.columns.str.strip()

# Clean Target Class (MDR)
Df = df.dropna(subset=[‘MDR’])
Df[‘MDR_binary’] = df[‘MDR’].map({‘YES’: 1, ‘NO’: 0})

# Standardize Sample Types
Df[‘Sample_Type_Clean’] = df[‘Sample_Type’].astype(str).str.strip().str.lower()
Df[‘Sample_Type_Clean’] = df[‘Sample_Type_Clean’].replace({
    ‘cloacal swap’: ‘cloacal swab’,
    ‘cloacal swabs’: ‘cloacal swab’,
    ‘milk sample’: ‘milk’,
    ‘ milk sample’: ‘milk’,
    ‘raw and fermented cow milk        ‘: ‘raw and fermented cow milk’
})

# Create Isolate_ID if not exists
If ‘Isolate_ID’ not in df.columns:
    Df[‘Isolate_ID’] = [f’Isolate_{i}’ for I in range(len(df))]

# Identify antibiotic columns
Metadata_cols = [‘Sample_Type’, ‘Location’, ‘Longtitude’, ‘Latitude’, ‘Date’,
                  ‘Org_Isolated’, ‘MAR_index’, ‘MDR’, ‘Isolate_ID’, ‘MDR_binary’,
                  ‘Sample_Type_Clean’, ‘S.No’, ‘Unnamed: 0’]
Antibiotic_cols = [col for col in df.columns if col not in metadata_cols]
# Fill missing with 0 (susceptible)
Df[antibiotic_cols] = df[antibiotic_cols].fillna(0)

Print(f”Dataset cleanly loaded. Shape: {df.shape}”)
Print(f”Number of antibiotic features: {len(antibiotic_cols)}\n”)


