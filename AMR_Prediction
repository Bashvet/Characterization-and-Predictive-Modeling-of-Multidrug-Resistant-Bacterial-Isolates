# OBJECTIVE IV: Unsupervised Antibiogram Phenotypic Clustering
# ==========================================
Print(“\n” + “=”*70)
Print(“OBJECTIVE IV: Unsupervised Antibiogram Phenotypic Clustering”)
Print(“=”*70)

# Subset antibiotic data matrix
X_clustering = df[antibiotic_cols].copy()

# Determine optimal number of clusters using elbow method and silhouette score
Inertias = []
Silhouette_scores = []
K_range = range(2, 11)

Print(“\nCalculating optimal number of clusters…”)
For k in k_range:
    Kmeans_temp = KMeans(n_clusters=k, random_state=42, n_init=10)
    Labels_temp = kmeans_temp.fit_predict(X_clustering)
    Inertias.append(kmeans_temp.inertia_)
    Sil_score = silhouette_score(X_clustering, labels_temp)
    Silhouette_scores.append(sil_score)
    Print(f”  k={k}: Silhouette Score = {sil_score:.3f}”)

# Plot elbow curve
Fig, axes = plt.subplots(1, 2, figsize=(14, 5))

Axes[0].plot(k_range, inertias, ‘bo-‘, linewidth=2, markersize=8)
Axes[0].set_xlabel(‘Number of Clusters (k)’)
Axes[0].set_ylabel(‘Inertia’)
Axes[0].set_title(‘Elbow Method for Optimal k’)
Axes[0].grid(True, alpha=0.3)

Axes[1].plot(k_range, silhouette_scores, ‘ro-‘, linewidth=2, markersize=8)
Axes[1].set_xlabel(‘Number of Clusters (k)’)
Axes[1].set_ylabel(‘Silhouette Score’)
Axes[1].set_title(‘Silhouette Score (higher = better)’)
Axes[1].axhline(y=max(silhouette_scores), color=’green’, linestyle=’—‘, alpha=0.7)
Axes[1].grid(True, alpha=0.3)

Plt.tight_layout()
Plt.savefig(f’{output_dir}/04_clustering_metrics.png’, dpi=100, bbox_inches=’tight’)
Plt.show()

# Choose optimal k (using silhouette score)
Optimal_k = k_range[np.argmax(silhouette_scores)]
Print(f”\n✓ Optimal number of clusters (by silhouette score): {optimal_k}”)

# Apply K-Means with optimal k
Kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
Df[‘Antibiogram_Cluster’] = kmeans.fit_predict(X_clustering)

# ==========================================
# Cluster Characteristics Table (Formatted)
# ==========================================
Print(“\n” + “=”*70)
Print(“TABLE 1: Antibiogram Phenotypic Cluster Characteristics”)
Print(“=”*70)

# Calculate comprehensive cluster profiles
Cluster_summary_list = []
Available_class_names = list(class_resistance_profiles.columns)

For cluster_id in range(optimal_k):
    Cluster_data = df[df[‘Antibiogram_Cluster’] == cluster_id]
   
    # Get dominant organism and sample type
    Dominant_org = cluster_data[‘Org_Isolated’].mode()
    Dominant_org = dominant_org.iloc[0] if len(dominant_org) > 0 else ‘Mixed’
   
    Dominant_sample = cluster_data[‘Sample_Type_Clean’].mode()
    Dominant_sample = dominant_sample.iloc[0] if len(dominant_sample) > 0 else ‘Mixed’
   
    # Calculate resistance burden score
    If len(available_class_names) > 0:
        Resistance_burden = cluster_data[available_class_names].mean().mean()
    Else:
        Resistance_burden = 0
   
    Cluster_summary_list.append({
        ‘Cluster_ID’: cluster_id,
        ‘Sample_Count’: len(cluster_data),
        ‘MDR_Prevalence (%)’: round(cluster_data[‘MDR_binary’].mean() * 100, 1),
        ‘Avg_MAR_Index’: round(cluster_data[‘MAR_index’].mean(), 3),
        ‘Dominant_Organism’: dominant_org,
        ‘Dominant_Sample_Type’: dominant_sample,
        ‘Resistance_Burden_Score’: round(resistance_burden, 3),
        ‘High_Risk_Cluster’: ‘Yes’ if cluster_data[‘MDR_binary’].mean() > 0.5 else ‘No’
    })

Cluster_profiles = pd.DataFrame(cluster_summary_list)

# Print formatted table
Print(“\n” + “-“*100)
Print(f”{‘Cluster’:<10} {‘Count’:<8} {‘MDR%’:<10} {‘MAR Index’:<12} {‘Dominant Organism’:<30} {‘Dominant Sample’:<22} {‘Risk’:<8}”)
