# ==========================================
# Visualize clusters with PCA
# ==========================================
Print(“\n--- Visualizing Antibiogram Clusters with PCA ---“)

# Standardize before PCA
Scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_clustering)

Pca = PCA(n_components=2, random_state=42)
Pca_components = pca.fit_transform(X_scaled)
Df[‘PCA1’] = pca_components[:, 0]
Df[‘PCA2’] = pca_components[:, 1]

# Calculate variance explained
Var_explained1 = pca.explained_variance_ratio_[0] * 100
Var_explained2 = pca.explained_variance_ratio_[1] * 100

Plt.figure(figsize=(12, 8))
Scatter = plt.scatter(df[‘PCA1’], df[‘PCA2’], c=df[‘Antibiogram_Cluster’],
                      Cmap=’tab10’, alpha=0.6, s=50)
Plt.colorbar(scatter, label=’Cluster ID’)
Plt.xlabel(f”Principal Component 1 ({var_explained1:.1f}% variance)”, fontsize=12)
Plt.ylabel(f”Principal Component 2 ({var_explained2:.1f}% variance)”, fontsize=12)
Plt.title(f”Phenotypic Antibiogram Clusters Visualized via PCA Space (k={optimal_k})”, fontsize=14)
Plt.tight_layout()
Plt.savefig(f’{output_dir}/04_cluster_pca_visualization.png’, dpi=100, bbox_inches=’tight’)
Plt.show()
Print(f”✓ PCA visualization saved to: {output_dir}/04_cluster_pca_visualization.png”)

